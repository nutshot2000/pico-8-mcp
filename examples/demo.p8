pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- demo: tiny auto-shooter used by the mcp server tests
-- ship on the left, drones fly in from the right

function _init()
 newgame()
end

function newgame()
 t=0 gs=0 kills=0 hits=0 hp=3
 p={x=16,y=64}
 e={} b={}
 st="play"
end

function tms(s)
 return flr(s/60)..":"..(s%60<10 and "0" or "")..s%60
end

function near(ax,ay,bx,by,r)
 local dx,dy=abs(ax-bx),abs(ay-by)
 return dx<r and dy<r and dx*dx+dy*dy<r*r
end

function hurt()
 hp-=1 hits+=1
 if hp<=0 then st="over" end
end

function _update()
 if st!="play" then
  if btnp(5) then newgame() end
  return
 end
 t+=1
 if t%30==0 then gs+=1 end
 if btn(2) then p.y-=2 end
 if btn(3) then p.y+=2 end
 p.y=mid(4,p.y,124)
 if t%8==0 then add(b,{x=p.x+4,y=p.y}) end
 if t%max(20,60-gs)==0 then
  add(e,{x=132,y=8+rnd(112),hp=2})
 end
 for bl in all(b) do
  bl.x+=4
  if bl.x>128 then del(b,bl) end
  for en in all(e) do
   if near(bl.x,bl.y,en.x,en.y,4) then
    en.hp-=1 del(b,bl)
    if en.hp<=0 then del(e,en) kills+=1 end
    break
   end
  end
 end
 for en in all(e) do
  en.x-=1
  if en.x<-8 then del(e,en)
  elseif near(en.x,en.y,p.x,p.y,5) then del(e,en) hurt() end
 end
end

function _draw()
 cls(0)
 spr(1,p.x-4,p.y-4)
 for bl in all(b) do line(bl.x,bl.y,bl.x-3,bl.y,10) end
 for en in all(e) do spr(2,en.x-4,en.y-4) end
 print("kills "..kills,1,1,7)
 print(tms(gs),100,1,7)
 for i=1,hp do rectfill(1+(i-1)*5,122,4+(i-1)*5,126,8) end
 if st=="over" then print("game over - ❎ retry",26,60,8) end
end
